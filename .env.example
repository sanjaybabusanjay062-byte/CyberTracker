# CYBERTRACE AI — Environment Configuration
SECRET_KEY=cybertrace-ai-enclave-secret-key-change-in-production-2026
DEBUG=False
DATABASE_URL=sqlite:///cybertrace.db
UPLOAD_FOLDER=uploads
REPORTS_FOLDER=reports
MAX_UPLOAD_SIZE_MB=50
WTF_CSRF_ENABLED=True

# AI Investigation Assistant Configuration
# Mode: "rule_based" (default, runs 100% offline with zero external API keys) or "llm"
AI_MODE=rule_based

# Optional: Google Gemini API Key (if provided, AI assistant uses Gemini grounded in evidence)
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional: OpenAI API Key (if provided and AI_MODE=llm)
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: MySQL support (uncomment and adjust to replace SQLite)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/cybertrace
